doctype html
html
  head
    title= title
    style
      include ../css/style.css
  body
    header(class="header-section")
      div(id="load-indicator")
    div(class="data-container")
        h2(id="top-message2")= title 
        if msg
          h1(id="header")= msg
        else 
          h1(id="header")
        div(class="cont-block hide")
            label(for="writethis") Write this
                input(type="text" id="writethis") 
            button(id="write") Send
        div(class="cont-block")
            h3(class="center") Convert to WebP and Avif
            p(id="file-path")
            label(id="convertthislabel" for="convertthis" class="center") <span class="button">Browse Files</span><br> or<br>
                input(type="file" accept="image/png, image/jpeg" id="convertthis")
            
            button(id="convert" class="hide") Start
            span(id="file-upload-indicator")
    div(id="content")
        div(id="preview")
    p(id="rand-location")= randLocation
    script
      include ../js/script.js
    script
      include ../js/draganddrop.js      